use strict;
use warnings;

# fix lib paths, some may be relative
BEGIN {
    require File::Spec;
    my @libs = ( "@RT_LIB_PATH@", "@LOCAL_LIB_PATH@" );
    my $bin_path;

    for my $lib (@libs) {
        unless ( File::Spec->file_name_is_absolute($lib) ) {
            unless ($bin_path) {
                if ( File::Spec->file_name_is_absolute(__FILE__) ) {
                    $bin_path = ( File::Spec->splitpath(__FILE__) )[1];
                } else {
                    require FindBin;
                    no warnings "once";
                    $bin_path = $FindBin::Bin;
                }
            }
            $lib = File::Spec->catfile( $bin_path, File::Spec->updir, $lib );
        }
        unshift @INC, $lib;
    }
}

use Getopt::Long;
use Pod::Usage;

my %opt = (
    delay            => 1,
    days             => 30,
    'per-queue-limit' => 15,
);

GetOptions(
    \%opt,
    'help|h',
    'source|s=s',
    'token|t=s',
    'queues|q=s',
    'all-queues',
    'per-queue-limit|limit|l=i',
    'days|d=i',
    'delay=i',
    'dry-run',
    'debug',
) or pod2usage(2);

pod2usage( { verbose => 2 } ) if $opt{help};

unless ( $opt{source} ) {
    pod2usage("--source is required");
}

unless ( $opt{token} ) {
    pod2usage("--token is required");
}

unless ( $opt{queues} || $opt{'all-queues'} ) {
    pod2usage("Either --queues or --all-queues is required");
}

use RT;
use RT::Interface::CLI qw(GetCurrentUser);

RT->LoadConfig();
RT->Config->Set( LogToSTDERR => $opt{debug} ? 'debug' : 'warning' );
RT->Init();

# Disable scrips during import (same pattern as CSV importer)
{
    use RT::Transaction;
    no warnings 'redefine';
    my $orig_create = \&RT::Transaction::Create;
    *RT::Transaction::Create = sub {
        my $self = shift;
        return $self->$orig_create( @_, ActivateScrips => 0 );
    };
}

require RT::Migrate::Importer;

my $current_user = GetCurrentUser();
unless ( $current_user->Id ) {
    RT->Logger->error(
        "No RT user found. Please consult your RT administrator.");
    exit(1);
}

my ( $created, $updated, $skipped, $imported ) = RT::Migrate::Importer->run(
    CurrentUser   => $current_user,
    Source        => $opt{source},
    Token         => $opt{token},
    Queues        => $opt{queues} ? [ split /,/, $opt{queues} ] : [],
    PerQueue      => $opt{'per-queue-limit'},
    Days          => $opt{days},
    Delay         => $opt{delay},
    DryRun        => $opt{'dry-run'},
);

print "\n";
print "=" x 60 . "\n";
print "Import Summary\n";
print "=" x 60 . "\n";

if ( $imported && @$imported ) {
    printf "%-12s %-12s %-15s %s\n", "Remote ID", "Local ID", "Queue", "Subject";
    print "-" x 60 . "\n";
    for my $t (@$imported) {
        printf "%-12d %-12d %-15s %s\n",
            $t->{remote_id},
            $t->{local_id},
            substr( $t->{queue}, 0, 15 ),
            substr( $t->{subject}, 0, 30 );
    }
    print "-" x 60 . "\n";
}

printf "Created: %d  Updated: %d  Skipped: %d\n", $created, $updated, $skipped;

__END__

=head1 NAME

rt-import-remote - Import tickets from a remote RT instance

=head1 SYNOPSIS

    rt-import-remote --source https://rt.example.com \
                     --token <API_TOKEN> \
                     --queues "General,Support" \
                     --days 30

    rt-import-remote --source https://rt.example.com \
                     --token <API_TOKEN> \
                     --all-queues --limit 50

=head1 DESCRIPTION

This script imports tickets from a remote RT instance to the local RT
instance via the REST2 API. It tracks which tickets have already been
imported to avoid duplicates on subsequent runs.

=head1 OPTIONS

=over

=item C<--source> I<URL> or C<-s> I<URL>

The URL of the remote RT instance to import from. Required.

=item C<--token> I<TOKEN> or C<-t> I<TOKEN>

The REST2 API token for authentication with the remote RT. Required.

=item C<--queues> I<LIST> or C<-q> I<LIST>

Comma-separated list of queue names to import. Use C<--all-queues> to
import from all queues.

=item C<--all-queues>

Import tickets from all queues on the remote system.

=item C<--per-queue-limit> I<N> or C<--limit> I<N> or C<-l> I<N>

Limit the import to N tickets per queue. Default: 15.

=item C<--days> I<N> or C<-d> I<N>

Import tickets created within the last N days. Default: 30.

=item C<--delay> I<SECONDS>

Seconds to sleep between importing each ticket to avoid hammering the remote
server. Default: 1.

=item C<--dry-run>

Show what would be imported without making any changes.

=item C<--debug>

Enable debug logging to STDERR.

=item C<--help> or C<-h>

Show this help message.

=back

=head1 STATE TRACKING

This script stores state in an RT::Attribute on RT::System named
C<RT-Import-Remote-State>. This tracks which remote tickets have been
imported and their corresponding local ticket IDs.

=head1 EXAMPLES

Import tickets from the General queue created in the last 7 days:

    rt-import-remote --source https://rt.example.com \
                     --token abc123 \
                     --queues General \
                     --days 7

Import from all queues, 50 tickets per queue:

    rt-import-remote --source https://rt.example.com \
                     --token abc123 \
                     --all-queues \
                     --limit 50 \
                     --debug

