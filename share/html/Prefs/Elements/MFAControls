<%init>
return if RT->Config->Get('DisableMFA');
return if $session{'WebExternallyAuthed'};

my $policy = $UserObj->EffectiveMFAPolicy;
my $mode   = $policy->{Mode};
return if $mode eq 'Off';
</%init>

<&| /Widgets/TitleBox, title => loc('Two-Factor Authentication'), id => "user-prefs-mfa" &>
  <&| /Elements/LabeledValue, Label => loc('Status'), ValueSpanClass => 'current-value' &>
    <% $UserObj->TOTPEnrolled ? loc('Enrolled') : loc('Not enrolled') %>
  </&>

% if ( $AllowActions ) {
%   if ( $mode eq 'Optional' && $UserObj->TOTPEnrolled ) {
  <div class="row mt-2">
    <div class="col-12">
      <& /Elements/Submit, Name => 'DisableMFA', Label => loc('Disable MFA') &>
    </div>
  </div>
%   } elsif ( $mode eq 'Optional' && !$UserObj->TOTPEnrolled ) {
  <div class="row mt-2">
    <div class="col-12 text-right">
      <a href="<% RT->Config->Get('WebPath') %>/NoAuth/MFA/Enroll.html" class="button btn btn-primary btn-light"><&|/l&>Set up MFA</&></a>
    </div>
  </div>
%   } elsif ( $mode eq 'Required' && $UserObj->TOTPEnrolled ) {
  <div class="row mt-2">
    <div class="col-12">
      <& /Elements/Submit, Name => 'RequestReset', Label => loc('Reset MFA enrollment via email') &>
    </div>
  </div>
%   }
% }
</&>

<%args>
$UserObj
$AllowActions => 1
</%args>
