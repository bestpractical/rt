<input type="hidden" name="code" id="mfa-code" value="" />
<div class="d-flex justify-content-center" id="mfa-code-inputs" style="gap: 0.5rem;">
% for my $i (0..5) {
  <input type="text" inputmode="numeric" maxlength="1" class="mfa-digit form-control text-center" style="width: 3rem; height: 3rem; font-size: 1.5rem; padding: 0;" data-index="<% $i %>"<% $i == 0 && $Autofocus ? ' autofocus="autofocus"' : '' %> autocomplete="one-time-code" />
% }
</div>
<script type="text/javascript">
jQuery(function($) {
    var $digits = $('#mfa-code-inputs .mfa-digit');
    var $hidden = $('#mfa-code');

    function syncHidden() {
        var code = '';
        $digits.each(function() { code += $(this).val(); });
        $hidden.val(code);
    }

    $digits.on('input', function() {
        var $el = $(this);
        // Keep only the last digit typed
        var val = $el.val().replace(/\D/g, '');
        if (val.length > 1) val = val.slice(-1);
        $el.val(val);
        syncHidden();
        // Auto-advance
        if (val && $el.data('index') < 5) {
            $digits.eq($el.data('index') + 1).focus();
        }
    });

    $digits.on('keydown', function(e) {
        var $el = $(this);
        var idx = $el.data('index');
        // Backspace: clear current, or if empty move to previous
        if (e.key === 'Backspace') {
            if (!$el.val() && idx > 0) {
                e.preventDefault();
                $digits.eq(idx - 1).val('').focus();
                syncHidden();
            }
        }
        // Left arrow
        else if (e.key === 'ArrowLeft' && idx > 0) {
            e.preventDefault();
            $digits.eq(idx - 1).focus();
        }
        // Right arrow
        else if (e.key === 'ArrowRight' && idx < 5) {
            e.preventDefault();
            $digits.eq(idx + 1).focus();
        }
    });

    // Handle paste on any digit
    $digits.on('paste', function(e) {
        e.preventDefault();
        var pasted = (e.originalEvent.clipboardData || window.clipboardData)
            .getData('text').replace(/\D/g, '').slice(0, 6);
        for (var i = 0; i < 6; i++) {
            $digits.eq(i).val(pasted.charAt(i) || '');
        }
        syncHidden();
        // Focus the next empty digit, or the last one
        var focusIdx = Math.min(pasted.length, 5);
        $digits.eq(focusIdx).focus();
    });
});
</script>
<%args>
$Autofocus => 0
</%args>
