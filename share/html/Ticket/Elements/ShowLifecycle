% if ($Ticket && $Ticket->id && $lifecycle_config) {
<div class="lifecycle-viewer-portlet">
  <div class="lifecycle-viewer"
       id="lifecycle-viewer-<% $Ticket->id %>"
       data-config="<% JSON($lifecycle_config) %>"
       data-layout="<% JSON($lifecycle_layout) %>"
       data-lifecycle="<% $lifecycle_name %>"
       data-ticket-id="<% $Ticket->id %>"
       data-confirm-status-change="<% $confirm_status_change %>"
       data-descriptions="<% JSON(\%descriptions) %>"
       data-current="<% $Ticket->Status %>">
    <div class="lifecycle-viewer-graph border rounded"></div>
  </div>

  <div class="modal lifecycle-confirm-modal" id="lifecycle-confirm-<% $Ticket->id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><&|/l&>Change status</&></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<&|/l&>Close</&>"></button>
        </div>
        <div class="modal-body">
          <p><&|/l&>Change this ticket's status to:</&> <strong class="lifecycle-target-status"></strong></p>
          <div class="form-check">
            <input class="form-check-input lifecycle-confirm-skip" type="checkbox" value="1" id="lifecycle-confirm-skip-<% $Ticket->id %>">
            <label class="form-check-label" for="lifecycle-confirm-skip-<% $Ticket->id %>">
              <&|/l&>Don't show this when changing status via lifecycle</&>
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><&|/l&>Cancel</&></button>
          <button type="button" class="btn btn-primary lifecycle-confirm-ok"><&|/l&>Change status</&></button>
        </div>
      </div>
    </div>
  </div>
</div>

% # Load here on demand because this is an optional widget.
% # We don't want to load all of cytoscape by default when most users don't need it.
<script type="text/javascript" src="<%RT->Config->Get('WebPath')%>/static/js/cytoscape.min.js"></script>
<script type="text/javascript" src="<%RT->Config->Get('WebPath')%>/static/js/cytoscape-popper.min.js"></script>
<script type="text/javascript" src="<%RT->Config->Get('WebPath')%>/static/js/lifecycleui.js"></script>
<script type="text/javascript" src="<%RT->Config->Get('WebPath')%>/static/js/lifecycleui-viewer.js"></script>
% }

<%INIT>
my $lifecycle_config;
my $lifecycle_layout = {};
my $lifecycle_name = '';
my %descriptions = ( statuses => {}, transitions => {} );

my $confirm_status_change
    = RT->Config->Get('LifecycleStatusChangeConfirm', $session{'CurrentUser'}) ? 1 : 0;

if ( $Ticket && $Ticket->id ) {
    my $lifecycle = $Ticket->QueueObj->LifecycleObj;
    if ($lifecycle && $lifecycle->Name) {
        $lifecycle_name = $lifecycle->Name;
        $lifecycle_layout = RT::Lifecycle->LoadLifecycleLayout( LifecycleObj => $lifecycle );

        # Show only the statuses and transitions the current user can reach from
        # this ticket's current status; everything else is dropped.
        $lifecycle_config = $lifecycle->FilterAllowedTransitions( Object => $Ticket );

        # Show user-facing descriptions for tooltips
        for my $status ( map { @{ $lifecycle_config->{$_} || [] } } qw/initial active inactive/ ) {
            my $desc = $lifecycle->StatusMetadata($status)->{description};
            $descriptions{statuses}{ lc $status } = $desc if defined $desc && length $desc;
        }
        my $transitions = $lifecycle_config->{transitions} || {};
        for my $from ( keys %$transitions ) {
            next unless length $from;
            for my $to ( @{ $transitions->{$from} } ) {
                # The merged value applies any matching wildcard descriptions too.
                my $desc = $lifecycle->TransitionMetadata( from => $from, to => $to )->{description};
                $descriptions{transitions}{ lc "$from -> $to" } = $desc
                    if defined $desc && length $desc;
            }
        }

        # FilterAllowedTransitions returns a shallow copy, so deleting these
        # keeps notes (and any unreachable statuses' metadata) out of the page
        # without touching the shared config.
        delete $lifecycle_config->{status_metadata};
        delete $lifecycle_config->{transition_metadata};
    }
}
</%INIT>
<%ARGS>
$Ticket => undef
</%ARGS>

<%attr>
directly_accessible => 1
</%attr>
