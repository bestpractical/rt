% $m->callback( %ARGS, CallbackName => 'BeforeWidget' );

<&| /Widgets/TitleBox, title => loc("Lifecycle"), class => 'ticket-info-lifecycle',
    ( $edit_link ? ( titleright_raw => $edit_link ) : () ) &>
  <div hx-trigger="ticketStatusChanged from:body" hx-get="<% RT->Config->Get('WebPath') %>/Views/Ticket/ShowLifecycle?id=<% $TicketObj->id %>">
    <& /Ticket/Elements/ShowLifecycle, Ticket => $TicketObj &>
  </div>
</&>

% $m->callback( %ARGS, CallbackName => 'AfterWidget' );

<%INIT>
# Link superusers to the global lifecycle config page. Mirror the gate in
# Admin/Lifecycles/autohandler exactly so the link never lands on a 403.
my $edit_link;
my $lifecycle = $TicketObj->LifecycleObj;
if ( $lifecycle && $lifecycle->Name
    && RT->Config->Get('ShowEditLifecycleConfig')
    && $session{'CurrentUser'}->UserObj->HasRight( Right => 'SuperUser', Object => $RT::System ) )
{
    my $edit_label = loc('Edit lifecycle');
    my $edit_url = RT->Config->Get('WebPath')
        . '/Admin/Lifecycles/Modify.html?Type=ticket&Name='
        . $m->interp->apply_escapes( $lifecycle->Name, 'u' );
    $edit_link
        = '<a hx-boost="false" href="' . $m->interp->apply_escapes( $edit_url, 'h' ) . '">'
        . qq{<span class="rt-inline-icon border rounded" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="$edit_label" aria-label="$edit_label">}
        . GetSVGImage( Name => 'gear' )
        . '</span></a>';
}
</%INIT>

<%ARGS>
$TicketObj
</%ARGS>
