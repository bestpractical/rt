<div class="modal fade" id="links-info-modal" tabindex="-1" aria-labelledby="links-info-modal-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="links-info-modal-title"><&|/l&>About links</&></h5>
        <a href="javascript:void(0)" class="close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </a>
      </div>
      <div class="modal-body">
        <h6><&|/l&>Link types</&></h6>
        <dl class="row small">
          <dt class="col-4"><&|/l&>Depends on</&></dt>
% if ($is_ticket) {
          <dd class="col-8"><&|/l, $noun &>This [_1] can't be resolved until the linked items are done.</&></dd>
% } else {
          <dd class="col-8"><&|/l, $noun &>This [_1] depends on the linked items.</&></dd>
% }
          <dt class="col-4"><&|/l&>Depended on by</&></dt>
          <dd class="col-8"><&|/l, $noun &>The linked items depend on this [_1].</&></dd>
          <dt class="col-4"><&|/l&>Parents</&></dt>
          <dd class="col-8"><&|/l, $noun &>The linked items are parents of this [_1].</&></dd>
          <dt class="col-4"><&|/l&>Children</&></dt>
          <dd class="col-8"><&|/l, $noun &>The linked items are children of this [_1].</&></dd>
          <dt class="col-4"><&|/l&>Refers to</&></dt>
          <dd class="col-8"><&|/l, $noun &>This [_1] references the linked items (no dependency).</&></dd>
          <dt class="col-4"><&|/l&>Referred to by</&></dt>
          <dd class="col-8"><&|/l, $noun &>The linked items reference this [_1].</&></dd>
        </dl>
        <h6 class="mt-3"><&|/l&>Shortcuts for the value field</&></h6>
        <dl class="row small">
          <dt class="col-4"><code>123</code> <&|/l&>or</&> <code>#123</code></dt>
          <dd class="col-8"><&|/l&>Ticket</&></dd>
          <dt class="col-4"><code>a:123</code></dt>
          <dd class="col-8"><&|/l&>Article</&></dd>
          <dt class="col-4"><code>asset:123</code></dt>
          <dd class="col-8"><&|/l&>Asset</&></dd>
          <dt class="col-4"><code>txn:123</code></dt>
          <dd class="col-8"><&|/l&>Transaction (or paste a transaction URL)</&></dd>
          <dt class="col-4"><code>user:123</code></dt>
          <dd class="col-8"><&|/l&>User</&></dd>
          <dt class="col-4"><code>group:123</code></dt>
          <dd class="col-8"><&|/l&>Group</&></dd>
          <dt class="col-4"><code>https://&hellip;</code></dt>
          <dd class="col-8"><&|/l&>Web Link</&></dd>
        </dl>
% $m->callback( CallbackName => 'ExtraLinkInstructions', Object => $Object );
      </div>
    </div>
  </div>
</div>
<%init>
# $noun comes from the dynamic loc(lc($Object->RecordType)) below, which the string extractor
# can't see, so register the values it can produce here ('item' is covered by the literal loc):
# loc('ticket')
# loc('asset')
my $noun = ( $Object && $Object->can('RecordType') ) ? loc( lc( $Object->RecordType ) ) : loc('item');
my $is_ticket = $Object && $Object->isa('RT::Ticket') ? 1 : 0;
</%init>
<%args>
$Object => undef
</%args>
