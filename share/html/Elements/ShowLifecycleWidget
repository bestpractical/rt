<&| /Widgets/TitleBox, title => loc("Lifecycle"), class => $titlebox_class,
    ( $edit_link ? ( titleright_raw => $edit_link ) : () ) &>
  <div hx-trigger="<% $Type %>StatusChanged from:body" hx-get="<% RT->Config->Get('WebPath') %>/Views/<% $view_type %>/ShowLifecycle?id=<% $Object->id %>">
% $m->comp( "/$view_type/Elements/ShowLifecycle", $view_type => $Object );
  </div>
</&>

%# Load cytoscape here, outside the status-refreshed div above, so a status
%# change re-renders only the graph markup and doesn't re-run these scripts.
%# Loaded on demand because most users never open a record with this portlet.
<script type="text/javascript" src="<%RT->Config->Get('WebPath')%>/static/js/cytoscape.min.js"></script>
<script type="text/javascript" src="<%RT->Config->Get('WebPath')%>/static/js/cytoscape-popper.min.js"></script>
<script type="text/javascript" src="<%RT->Config->Get('WebPath')%>/static/js/lifecycleui.js"></script>
<script type="text/javascript" src="<%RT->Config->Get('WebPath')%>/static/js/lifecycleui-viewer.js"></script>

<%INIT>
my $view_type = ucfirst $Type;
my %titlebox_class = (
    ticket => 'ticket-info-lifecycle',
    asset  => 'asset-lifecycle',
);
my $titlebox_class = $titlebox_class{$Type};

# Link superusers to the global lifecycle config page. Mirror the gate in
# Admin/Lifecycles/autohandler exactly so the link never lands on a 403.
my $edit_link;
my $lifecycle = $Object->LifecycleObj;
if ( $lifecycle && $lifecycle->Name
    && RT->Config->Get('ShowEditLifecycleConfig')
    && $session{'CurrentUser'}->UserObj->HasRight( Right => 'SuperUser', Object => $RT::System ) )
{
    my $edit_label = loc('Edit lifecycle');
    my $edit_url = RT->Config->Get('WebPath')
        . "/Admin/Lifecycles/Modify.html?Type=$Type&Name="
        . $m->interp->apply_escapes( $lifecycle->Name, 'u' );
    $edit_link
        = '<a hx-boost="false" href="' . $m->interp->apply_escapes( $edit_url, 'h' ) . '">'
        . qq{<span class="rt-inline-icon border rounded" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="$edit_label" aria-label="$edit_label">}
        . GetSVGImage( Name => 'gear' )
        . '</span></a>';
}
</%INIT>

<%ARGS>
$Object
$Type
</%ARGS>
