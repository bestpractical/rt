</%METHOD>

<%METHOD EditWidgetHistory>
<div class="modal fade pagelayout-widget-modal" id="pagelayout-widget-<% $Index // $Widget %>-modal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form hx-boost="false" class="pagelayout-widget-form">
        <div class="modal-header">
          <h5 class="modal-title"><% loc('Modify Element') %></h5>
          <a href="javascript:void(0)" class="close" data-bs-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </a>
        </div>
        <div class="modal-body">
          <&| /Elements/LabeledValue, Label => loc("Default Transaction Types"), LabelTooltip => loc('Configure which transaction types are shown by default in the history') &>
            <& /Elements/TransactionTypeFilterDropdown,
               Object => $Class,
               ShowSelectActions => 0,
               AllChecked => 1,
               RenderAsDropdown => 1,
               For => $Index,
               ref $Widget && $Widget->{FilterTxnTypes} ? ( FilterTxnTypes => $Widget->{FilterTxnTypes} ) : (),
            &>
          </&>
          <& $show_history_meta->{Widget} || '/Widgets/Form/Select',
             Name => 'ShowHistory',
             Tooltip => loc('Configure how history is displayed on this page'),
             CurrentValue => ( ref $Widget && $Widget->{ShowHistory} ) // '',
             DefaultLabel => loc('Use system default'),
             %{ $show_history_meta->{WidgetArguments} || {} },
             Description => loc('Show History'),
             LabeledValue => 1,
             $Index ? () : ( InputClass => 'form-select' ),
          &>

          <& /Widgets/Form/Integer,
             Name => 'PerPage',
             Description => loc('Transactions Per Page'),
             Tooltip => loc('Number of transactions to show per page for paged history'),
             CurrentValue => ( ref $Widget && $Widget->{PerPage} ) // '',
             DefaultValue => 10,
             Min => 1,
             Max => 100,
             LabeledValue => 1
          &>
        </div>
        <div class="modal-footer">
          <& /Elements/Submit, Label => loc('Update') &>
        </div>
      </form>
    </div>
  </div>
</div>
<%INIT>
# Get ShowHistory configuration metadata from RT::Config
my $show_history_meta = RT->Config->Meta('ShowHistory');
# For assets, limit ShowHistory options to just "page" mode
if ( $Class && $Class eq 'RT::Asset' ) {
    # Override the widget arguments to show only relevant options for assets
    $show_history_meta->{WidgetArguments}{Values}      = [qw(page)];
    $show_history_meta->{WidgetArguments}{ValuesLabel} = {
        page => "one page at a time",    #loc
    };
}
</%INIT>
<%ARGS>
$Widget => undef
$Index => undef
$Class => undef
</%ARGS>
</%METHOD>


<%METHOD EditWidgetCustomRoles>
<div class="modal fade pagelayout-widget-modal" id="pagelayout-widget-<% $Index // $Widget %>-modal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form hx-boost="false" class="pagelayout-widget-form">
        <div class="modal-header">
          <h5 class="modal-title"><% loc('Modify Element') %></h5>
          <a href="javascript:void(0)" class="close" data-bs-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </a>
        </div>
        <div class="modal-body">
% my $custom_roles = RT::CustomRoles->new( $session{CurrentUser} );
% if ( $Class ) {
%   $custom_roles->LimitToLookupType( $Class->CustomFieldLookupType );
% }
% if ( $WidgetName eq 'Basics' ) {
%   $custom_roles->LimitToSingleValue;
% } elsif ( $WidgetName eq 'Message' )  {
%   $custom_roles->LimitToMultipleValue;
% }
% $custom_roles->UnLimit;
% if ( $custom_roles->Count > 0 ) {
          <&| /Elements/LabeledValue, Label => loc("Custom Role Visibility"), LabelTooltip => loc('Configure which custom roles are visible in this [_1] widget', $WidgetName) &>
% while ( my $role = $custom_roles->Next ) {
            <div class="row mb-2">
              <div class="col-sm-4">
                <label class="form-label"><% $role->Name %></label>
              </div>
              <div class="col-sm-8">
                <div class="form-check form-check-inline">
% my $is_hidden = 1 if ref $Widget && grep { $role->Name eq $_ } @{ $Widget->{HiddenRoles} || [] };
                  <input class="form-check-input" type="radio" name="Role-<% $role->Name %>" id="<% $Index %>-Role-<% $role->Id %>-Show" value="show" <% $is_hidden ? '' : 'checked' %>>
                  <label class="form-check-label" for="<% $Index %>-Role-<% $role->Id %>-Show">
                    <% loc('Show') %>
                  </label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="Role-<% $role->Name %>" id="<% $Index %>-Role-<% $role->Id %>-Hide" value="hide" <% $is_hidden ? 'checked' : '' %>>
                  <label class="form-check-label" for="<% $Index %>-Role-<% $role->Id %>-Hide">
                    <% loc('Hide') %>
                  </label>
                </div>
              </div>
            </div>
% }
          </&>
% } else {
          <div class="alert alert-info">
            <% loc('Add a custom role to configure it in the [_1] widget.', $WidgetName) %>
          </div>
% }
        </div>
        <div class="modal-footer">
          <& /Elements/Submit, Label => loc('Update') &>
        </div>
      </form>
    </div>
  </div>
</div>
<%ARGS>
$Widget => undef
$Index => undef
$Class => undef
$Page => undef
$WidgetName => undef
</%ARGS>
</%METHOD>

<%METHOD EditWidgetMessage>
<& SELF:EditWidgetCustomRoles, %ARGS, WidgetName => 'Message' &>
</%METHOD>

<%METHOD EditWidgetPeople>
<& SELF:EditWidgetCustomRoles, %ARGS, WidgetName => 'People' &>
</%METHOD>

<%METHOD EditWidgetBasics>
<& SELF:EditWidgetCustomRoles, %ARGS, WidgetName => 'Basics' &>
</%METHOD>
