<div class="lifecycle-ui" id="lifecycle-<% $id %>" data-config="<% $Config %>" data-maps="<% $Maps %>" data-layout="<% $Layout || '' %>" >
  <div id="lifecycle-ui-edit-node" class="lifeycycle-ui-edit-node collapse card card-body">
    <input type="hidden" name="id" />
    <div class="alert alert-warning invalid-name hidden"><&|/l&>Invalid name</&></div>
    <&| /Elements/LabeledValue, Label => loc('Name') &>
      <input class="form-control" type="text" id="name" name="name" value="" />
    </&>

    <&| /Elements/LabeledValue, Label => loc('Type') &>
        <select class="form-select selectpicker" id="type" name="type">
          <option value="initial"><&|/l&>Initial</&></option>
          <option value="active"><&|/l&>Active</&></option>
          <option value="inactive"><&|/l&>Inactive</&></option>
        </select>
    </&>

    <&| /Elements/LabeledValue, Label => loc('Color') &>
      <div class="form-check mb-1">
        <input class="form-check-input" type="checkbox" id="color-use" name="color-use" checked />
        <label class="form-check-label" for="color-use"><% loc('Set status color') %></label>
      </div>
      <div class="input-group" id="color-inputs">
        <input class="form-control form-control-color" type="color" id="color" name="color" value="#547CCC" />
        <input class="form-control" type="text" id="color-hex" name="color-hex" value="#547CCC" placeholder="#000000" maxlength="7" />
      </div>
    </&>
    <div class="row mt-3 g-2">
      <div class="col-4 d-grid">
        <button class="btn btn-outline-danger" id="DeleteNode"><&|/l&>Delete</&></button>
      </div>
      <div class="col-4 d-grid">
        <button class="btn btn-light" id="CancelNode"><&|/l&>Cancel</&></button>
      </div>
      <div class="col-4 d-grid">
        <button class="btn btn-primary" id="SaveNode"><&|/l&>Save</&></button>
      </div>
    </div>
  </div>

  <div class="row mt-2">
    <div class="col-12">
      <div class="lifecycle-graph border rounded" style="width: 100%; height: 560px;"></div>
    </div>
  </div>

  <div class="row mt-2">
    <div class="col-auto">
      <button class="btn btn-light btn-sm" id="AutoArrange" type="button"><&|/l&>Auto-arrange</&></button>\
<% GetSVGImage( Name => 'info', ExtraClasses => 'icon-helper ms-1', Title => loc("Automatically space out the statuses. Drag nodes to fine-tune, then Save to make the arrangement permanent for the viewer."), Size => 12 ) |n %>
    </div>
  </div>
  <div class="row">
    <div class="col-auto">
      <p>
        <&|/l&>Click in the open space to <strong>add a status</strong>.<br>
Click on a status to <strong>edit</strong> it; press Delete to <strong>remove</strong> it.<br>
Click and drag a status to <strong>change the graph layout</strong>.<br>
Shift + drag from one status to another to <strong>add a transition</strong>.<br>
Click a transition to select it, then click again to <strong>change its direction</strong>.<br>
Hover a transition and click the &times; (or press Delete) to <strong>remove</strong> it.<br></&>
      </p>
    </div>
  </div>
</div>

<%INIT>
my $id = $Name . '-' . int(rand(2**31));
</%INIT>

<%ARGS>
$Config
$Name
$Maps
$Layout => ''
</%ARGS>
