<div class="ticket-links">
% for my $type (@render) {
  <& /Elements/ShowLinksSection,
      Object   => $Object,
      Type     => $type,
      Label    => $labels{$type},
      Formats  => \%formats,
      Edit     => $Edit,
      DualMode => $DualMode,
      Embedded => $Embedded,
  &>
% }
  <span class="links-total d-none" data-links-total="<% $links_total %>"></span>
</div>
% $m->callback( %ARGS );
% if ($DualMode) {
  <div class="links-cf-display"><& /Elements/ShowCustomFields, Object => $Object, Grouping => 'Links', Table => 0 &></div>
  <div class="links-cf-edit"><& /Elements/EditCustomFields, Object => $Object, Grouping => 'Links', InTable => 0 &></div>
% } elsif ($Edit) {
  <& /Elements/EditCustomFields, Object => $Object, Grouping => 'Links', InTable => 0 &>
% } else {
  <& /Elements/ShowCustomFields, Object => $Object, Grouping => 'Links', Table => 0 &>
% }
%#  In DualMode the Links widget renders this outside its inline-edit <form> (a nested <form> is
%#  invalid HTML and gets dropped); render it inline only for the standalone/display path.
%   if ( $Object->isa('RT::Ticket') && !$Embedded && !$DualMode ) {
<& /Elements/CreateLinkedTicket, Object => $Object &>
%   }

<%INIT>
$m->notes( LinkDeleteDualMode => $DualMode ? 1 : 0 );
$m->notes( LinkParentId       => $Object->id );
$m->notes( LinkUpdatePath     => $Object->isa('RT::Asset') ? RT->Config->Get('WebPath') . '/Helpers/AssetUpdate'
                                                           : RT->Config->Get('WebPath') . '/Helpers/TicketUpdate' );

my @display = qw(DependsOn DependedOnBy MemberOf Members RefersTo ReferredToBy);
$m->callback( %ARGS, CallbackName => 'ChangeDisplay', display => \@display );
my %labels  = (
    DependsOn       => loc('Depends on'),
    DependedOnBy    => loc('Depended on by'),
    MemberOf        => loc('Parents'),
    Members         => loc('Children'),
    RefersTo        => loc('Refers to'),
    ReferredToBy    => loc('Referred to by'),
);

my %formats = %{ RT->Config->Get('LinksFormat') || {} };

my @render = @display;

my $links_total = $Object->Links('Base')->Count + $Object->Links('Target')->Count;
</%INIT>

<%ARGS>
$Object
$Edit     => 0
$DualMode => 0
$Embedded => 0
</%ARGS>

<%attr>
directly_accessible => 1
</%attr>
