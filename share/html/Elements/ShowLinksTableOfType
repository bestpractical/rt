% if ( $collection && $collection->Count ) {
<div class="links-type-table<% $default_format ? ' links-default-format' : '' %>" data-links-object-type="<% $object_type %>"<% defined $FormatName ? ' data-links-format="' . $m->interp->apply_escapes( $FormatName, 'h' ) . '"' : '' |n %><% $Edit ? qq{ data-link-delete-type="$link_delete_type" data-link-delete-mode="$link_delete_mode"} : '' |n %>>
<& /Elements/CollectionList,
    Collection     => $collection,
    Format         => $format,
    Rows           => scalar(@$Ids),
    ShowNavigation => 0,
    AllowSorting   => 0,
    ShowEmpty      => 0,
    MarkInactive   => 1,
    ( $Embedded ? ( InlineEdit => 0 ) : () ),
&>
</div>
% }
<%init>
( $Format, $FormatName ) = RT::Links->LinkListingFormat( Class => $Class ) unless $Format;
my $format = $Format || "'__id__'";

( my $object_type = $Class ) =~ s/^RT:://;

my $meta    = RT->Config->Meta('LinksFormat') || {};
my ($core)  = grep { !$_->{SiteConfig} && !$_->{Database} } @{ $meta->{Sources} || [] };
my $shipped = ( $core ? $core->{Value}{Default} : undef ) || {};
my $norm    = sub { ( my $s = shift // '' ) =~ s/\s+//g; $s };
my $default_format
    = length $norm->( $shipped->{$Class} ) && $norm->($Format) eq $norm->( $shipped->{$Class} ) ? 1 : 0;

# Title the first column after the object type, so the per-type tables within one relationship
# section are easy to tell apart. Abbreviate the long "Transaction" for the default format, whose
# fixed first-column width (see boxes.css) is too narrow to hold the full word without wrapping.
my $type_label
    = ( $object_type eq 'Transaction' && $default_format ) ? loc('Txn') : loc( ucfirst $object_type );

# Guard the label before injecting it into the Format string: a quote would close the column
# and a slash would start another column attribute. Strip those, as localizations vary.
$type_label =~ s{['"/\\]}{}g;
# A custom LinksFormat may quote the first column with either ' or " (both are valid,
# see CollectionAsTable/ParseFormat); matching only ' would skip a double-quoted format.
$format     =~ s{(['"])(.*?)\1}{$1 . $2 . "/TITLE:$type_label" . $1}e;

my ( $link_delete_type, $link_delete_mode );
if ($Edit) {
    my $canonical = $RT::Link::TYPEMAP{$RelationshipType} || {};
    $link_delete_type = $canonical->{Type} || $RelationshipType;
    $link_delete_mode = $canonical->{Mode} || 'Target';
    $m->notes( LinkDeleteType => $link_delete_type );
    $m->notes( LinkDeleteMode => $link_delete_mode );

    # Keep the delete column first: boxes.css finds it, and the id column after it, by position.
    $format = "'__DeleteLinkCheckBox__', " . $format;
}

my $collection = RT::Links->FilterLinkListing(
    CurrentUser      => $session{CurrentUser},
    Class            => $Class,
    Ids              => $Ids,
    RelationshipType => $RelationshipType,
);
</%init>
<%args>
$Class
$Ids              => []
$RelationshipType => ''
$Format           => undef
$FormatName       => undef
$Edit             => 0
$Embedded         => 0
</%args>
