% if ( $collection && $collection->Count ) {
<div class="links-type-table<% $default_format ? ' links-default-format' : '' %>" data-links-object-type="<% $object_type %>"<% $Edit ? qq{ data-link-delete-type="$link_delete_type" data-link-delete-mode="$link_delete_mode"} : '' |n %>>
<& /Elements/CollectionList,
    Collection     => $collection,
    Format         => $format,
    Rows           => scalar(@$Ids),
    ShowNavigation => 0,
    AllowSorting   => 0,
    ShowEmpty      => 0,
    MarkInactive   => 1,
    ( $Embedded ? ( InlineEdit => 0 ) : () ),
&>
</div>
% }
<%init>
my %collection_class = (
    'RT::Ticket'      => 'RT::Tickets',
    'RT::Transaction' => 'RT::Transactions',
    'RT::Asset'       => 'RT::Assets',
    'RT::Article'     => 'RT::Articles',
    'RT::User'        => 'RT::Users',
    'RT::Group'       => 'RT::Groups',
);

my $cclass = $collection_class{$Class};
my $collection;
my $format = $Format || ( RT->Config->Get('LinksFormat') || {} )->{$Class} || "'__id__'";

( my $object_type = $Class ) =~ s/^RT:://;

my $meta    = RT->Config->Meta('LinksFormat') || {};
my ($core)  = grep { !$_->{SiteConfig} && !$_->{Database} } @{ $meta->{Sources} || [] };
my $shipped = $core ? $core->{Value} : {};
my $norm    = sub { ( my $s = shift // '' ) =~ s/\s+//g; $s };
my $default_format
    = length $norm->( $shipped->{$Class} ) && $norm->($Format) eq $norm->( $shipped->{$Class} ) ? 1 : 0;

# Title the first column after the object type, so the per-type tables within one relationship
# section are easy to tell apart. Abbreviate the long "Transaction" for the default format, whose
# fixed first-column width (see boxes.css) is too narrow to hold the full word without wrapping.
my $type_label
    = ( $object_type eq 'Transaction' && $default_format ) ? loc('Txn') : loc( ucfirst $object_type );

# Guard the label before injecting it into the Format string: a quote would close the column
# and a slash would start another column attribute. Strip those, as localizations vary.
$type_label =~ s{['"/\\]}{}g;
$format     =~ s{'([^']*)'}{"'$1/TITLE:$type_label'"}e;

my ( $link_delete_type, $link_delete_mode );
if ($Edit) {
    my $canonical = $RT::Link::TYPEMAP{$RelationshipType} || {};
    $link_delete_type = $canonical->{Type} || $RelationshipType;
    $link_delete_mode = $canonical->{Mode} || 'Target';
    $m->notes( LinkDeleteType => $link_delete_type );
    $m->notes( LinkDeleteMode => $link_delete_mode );

    # The widget's trash link trails the row; the embedded (Jumbo) checkbox leads it.
    $format
        = $m->notes('LinkDeleteDualMode')
        ? $format . ", '__DeleteLinkCheckBox__'"
        : "'__DeleteLinkCheckBox__', " . $format;
}

if ( $cclass && @$Ids ) {
    $collection = $cclass->new( $session{CurrentUser} );
    $collection->Limit(
        FIELD           => 'id',
        OPERATOR        => '=',
        VALUE           => $_,
        ENTRYAGGREGATOR => 'OR',
        )
        for @$Ids;

    # Preserved filters: keep reminders out of ReferredToBy, hide disabled articles.
    if ( $Class eq 'RT::Ticket' && $RelationshipType eq 'ReferredToBy' ) {
        $collection->Limit( FIELD => 'Type', OPERATOR => '!=', VALUE => 'reminder' );
    }
    if ( $Class eq 'RT::Article' ) {
        $collection->Limit( FIELD => 'Disabled', OPERATOR => '=', VALUE => 0 );
    }

    # Deterministic row order: by id for most types; users and groups read better
    # alphabetically (also their collection default), so order those by Name.
    if ( $Class eq 'RT::User' || $Class eq 'RT::Group' ) {
        $collection->OrderBy( FIELD => 'Name', ORDER => 'ASC' );
    }
    else {
        $collection->OrderBy( FIELD => 'id', ORDER => 'ASC' );
    }
}
</%init>
<%args>
$Class
$Ids              => []
$RelationshipType => ''
$Format           => undef
$Edit             => 0
$Embedded         => 0
</%args>
