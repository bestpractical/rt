<&| /Elements/LabeledValue, Label => loc('Password status'), ValueSpanClass => 'current-value' &>
  <% $password_status %>
</&>
% if ($is_admin_view) {
  <div class="row mt-2">
    <div class="col-12">
      <div class="custom-control custom-checkbox">
        <input value="1" class="custom-control-input" id="SendPasswordResetEmail" name="SendPasswordResetEmail" type="checkbox" />
        <label class="custom-control-label" for="SendPasswordResetEmail"><&|/l&>Send new password email</&></label>
      </div>
    </div>
  </div>
% if ( $User->HasPassword ) {
  <div class="row mt-2">
    <div class="col-12">
      <div class="custom-control custom-checkbox">
        <input value="1" class="custom-control-input" id="DeleteUserPassword" name="DeleteUserPassword" type="checkbox" />
        <label class="custom-control-label" for="DeleteUserPassword"><&|/l&>Delete password (User will have no password set)</&></label>
      </div>
    </div>
  </div>
% }
% }
% if ( $policy_text ) {
<&| /Elements/LabeledValue, Label => loc('Password requirements'), ValueSpanClass => 'current-value' &>
  <span class="form-text text-muted"><% $policy_text %></span>
</&>
% }
% unless ( $cond{'CanSet'} ) {
<% $cond{'Reason'} %><br />
% } else {

% if ( $cond{'RequireCurrent'} ) {
  <&| /Elements/LabeledValue, Label => loc( "[_1]'s current password",$session{'CurrentUser'}->Name()) &>
    <input type="password" class="form-control" name="<% $Name[0] %>" size="16" autocomplete="off" />
  </&>
% }

<&| /Elements/LabeledValue, Label => loc("New password") &>
  <input type="password" class="form-control" name="<% $Name[1] %>" size="16" autocomplete="off" />
</&>
<&| /Elements/LabeledValue, Label => loc("Retype Password") &>
  <input type="password" class="form-control" name="<% $Name[2] %>" size="16" autocomplete="off" />
</&>
% }

<%ARGS>
$User
@Name => qw(CurrentPass NewPass1 NewPass2)
</%ARGS>
<%INIT>

my %cond = $User->CurrentUserRequireToSetPassword;

my @policy_requirements = $User->PasswordPolicyRequirements;
my $policy_text = join( " \N{MIDDLE DOT} ", @policy_requirements );

my $password_status
  = $User->HasPassword ? loc('Password is set') : loc('No password set');

# Admin view: current user is modifying someone else's account
my $is_admin_view = $User->Id
  && $session{'CurrentUser'}->Id != $User->Id
  && $session{'CurrentUser'}->HasRight( Right => 'AdminUsers', Object => RT->System );

</%INIT>
