%# Marks one row of a list for removal when the enclosing form is saved.
%# Checking it adds pending-delete to the enclosing tr or li (see init.js),
%# which tints the row and shows the trash icon.
%# Name: the form field the server processes, also used as the id; for links,
%# a DeleteLink-* name. Label: the checkbox's localized accessible name,
%# e.g. "Remove link to Ticket #12".
<div class="form-check">
  <input type="checkbox" name="<% $Name |h %>" id="<% $Name |h %>" value="1" class="checkbox form-check-input delete-checkbox" aria-label="<% $Label |h %>" />
  <label class="form-check-label" for="<% $Name |h %>"><span class="pending-delete-icon text-danger" aria-hidden="true" data-bs-toggle="tooltip" title="<% loc('Will be removed') |h %>"><% GetSVGImage( Name => 'trash' ) |n %></span></label>
</div>
<%ARGS>
$Name
$Label
</%ARGS>
