<%init>
my $links = $Object->$Type;
my $total = $links->Count;
return unless $total;

my $mode           = $RT::Link::TYPEMAP{$Type}{Mode};                                           # 'Target' or 'Base'
my $ModeURI        = "${mode}URI";
my $canonical_type = $RT::Link::TYPEMAP{$Type}{Type};
my @type_order     = qw(RT::Ticket RT::Transaction RT::Asset RT::Article RT::User RT::Group);

my %ids;     # class => [ local ids in encounter order ]
my @urls;    # link objects whose target is an external URL

$links->GotoFirstItem;
while ( my $link = $links->Next ) {
    my ( $class, $id ) = RT::URI->ParseObjectURI( $link->$mode );
    if ($class) {
        push @{ $ids{$class} ||= [] }, $id;
    }
    else {
        push @urls, $link;
    }
}

my %show_ids  = %ids;
my @show_urls = @urls;

# The ticket Children section renders as a recursive tree only when every member is a local
# ticket; mixed/url members fall back to the flat per-type tables.
my $emit_delete = $Edit || $DualMode;
my $dual        = $DualMode;

my $use_tree
    = $Type eq 'Members'
    && ( $DualMode || !$Edit )
    && $Object->isa('RT::Ticket')
    && !@urls
    && ( keys(%ids) == 1 && exists $ids{'RT::Ticket'} ) ? 1 : 0;

# Render the children tree (or the per-type tables) up front so the whole section -- label
# included -- can be skipped when it has no content.
my $content = '';
if ($use_tree) {
    $content = $m->scomp( '/Elements/ShowLinksTree', Object => $Object, Edit => $emit_delete ) // '';
}
else {
    for my $class (@type_order) {
        next unless $show_ids{$class} && @{ $show_ids{$class} };
        $content .= $m->scomp(
            '/Elements/ShowLinksTableOfType',
            Class            => $class,
            Ids              => $show_ids{$class},
            RelationshipType => $Type,
            Format           => $Formats->{$class},
            Edit             => $emit_delete,
            Embedded         => $Embedded,
        ) // '';
    }
}
</%init>
<%args>
$Object
$Type
$Label
$Formats
$Edit     => 0
$DualMode => 0
$Embedded => 0
</%args>
