<div class="kanban-wrapper">
% if ( $HasResults && $Collection->Count ) {
  <div class="kanban-board inline-edit<% $swimlane_field ? ' kanban-board-with-swimlanes' : '' %>" data-kanban-field="<% $kanban_field %>"<% $swimlane_field ? ' data-swimlane-field="' . $swimlane_field . '"' : '' |n %>>
%   if ( $swimlane_field ) {
%     # Render with swimlanes (2D layout)
%     for my $swimlane ( @swimlanes ) {
        <div class="kanban-swimlane" data-swimlane-value="<% $swimlane %>">
          <div class="kanban-swimlane-header bg-body-secondary border-end p-3">
            <h6 class="mb-0 fw-semibold"><% $swimlane || loc('(no value)') %></h6>
          </div>
          <div class="kanban-swimlane-columns">
%           for my $column ( @columns ) {
              <div class="kanban-column card" data-column-value="<% $column %>" data-swimlane-value="<% $swimlane %>">
%               if ( $swimlane eq $swimlanes[0] ) {
                  <div class="kanban-column-header card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                      <% $column || loc('(no value)') %>
                    </h5>
                  </div>
%               }
                <div class="kanban-column-cards card-body p-2" data-column-value="<% $column %>" data-swimlane-value="<% $swimlane %>">
%                 my $tickets_in_cell = $grouped_tickets->{$swimlane}{$column} || [];
%                 for my $ticket ( @$tickets_in_cell ) {
                    <& /Search/Elements/KanbanCard, Ticket => $ticket, KanbanField => $kanban_field, ParsedFormat => $parsed_format &>
%                 }
                </div>
              </div>
%           }
          </div>
        </div>
%     }
%   } else {
%     # Render without swimlanes (1D layout - backwards compatible)
%     for my $column ( @columns ) {
        <div class="kanban-column card" data-column-value="<% $column %>">
          <div class="kanban-column-header card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <% $column || loc('(no value)') %>
            </h5>
            <span class="badge text-bg-secondary">
              <% scalar @{ $grouped_tickets->{''}{$column} || [] } %>
            </span>
          </div>
          <div class="kanban-column-cards card-body p-2" data-column-value="<% $column %>">
%           for my $ticket ( @{ $grouped_tickets->{''}{$column} || [] } ) {
              <& /Search/Elements/KanbanCard, Ticket => $ticket, KanbanField => $kanban_field, ParsedFormat => $parsed_format &>
%           }
          </div>
        </div>
%     }
%   }
  </div>
% } elsif ( !$HasResults ) {
  <div class="alert alert-info">
    <&|/l&>No search results</&>
  </div>
% } else {
  <div class="alert alert-info">
    <&|/l&>No tickets found matching your search criteria</&>
  </div>
% }
</div>

<%INIT>
use RT::Search::Kanban;

if ( !$Collection ) {
    $Collection = $Class->new( $session{'CurrentUser'} );
    $Collection->FromSQL( $Query ) if $Query;
}

$HasResults = defined $Collection;

my $kanban_field = $KanbanGroupBy || RT::Search::Kanban::GetKanbanField(
    SavedSearch => $SavedSearchObj,
);

my $swimlane_field = $KanbanSwimLane;
unless ( defined $swimlane_field ) {
    $swimlane_field = RT::Search::Kanban::GetKanbanSwimLane(
        SavedSearch => $SavedSearchObj,
    );
}

my $kanban_format = $KanbanFormat;
unless ( $kanban_format ) {
    if ( $SavedSearchObj && $SavedSearchObj->can('GetOption') ) {
        $kanban_format = $SavedSearchObj->GetOption('KanbanFormat');
    }
    $kanban_format ||= RT->Config->Get('DefaultKanbanCardFormat') || '__Priority__, __Owner__, __Queue__, __Due__';
}

my $parsed_format;
eval {
    my $DisplayFormat = $m->comp('/Elements/ScrubHTML', Content => $kanban_format, Restrictive => 1);
    my @Format = $m->comp('/Elements/CollectionAsTable/ParseFormat', Format => $DisplayFormat);
    $parsed_format = \@Format;
};
if ($@) {
    RT->Logger->error("Error parsing Kanban card format: $@");
    $parsed_format = [];
}

my @columns = RT::Search::Kanban::GetKanbanColumns(
    Tickets => $Collection,
    Field   => $kanban_field,
);

my $grouped_tickets;
my @swimlanes;

if ( $swimlane_field ) {
    $grouped_tickets = RT::Search::Kanban::GroupTicketsByTwoFields(
        Tickets       => $Collection,
        ColumnField   => $kanban_field,
        SwimLaneField => $swimlane_field,
    );

    @swimlanes = sort keys %$grouped_tickets;
} else {
    $grouped_tickets = RT::Search::Kanban::GroupTicketsByField(
        Tickets => $Collection,
        Field   => $kanban_field,
    );
    $grouped_tickets = { '' => $grouped_tickets };
    @swimlanes = ('');
}
</%INIT>

<%ARGS>
$Collection => undef
$Query => undef
$OrderBy => undef
$Order => undef
$RowsPerPage => undef
$Page => undef
$SavedSearchObj => undef
$HasResults => 1
$Class => 'RT::Tickets'
$KanbanGroupBy => undef
$KanbanSwimLane => undef
$KanbanFormat => undef
</%ARGS>
