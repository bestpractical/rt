<%perl>
my $spanning_tickets_for_today    = $TicketsSpanningDays->{$today}    || [];
my $spanning_tickets_for_tomorrow = $TicketsSpanningDays->{$tomorrow} || [];
my $first_day_of_the_event = 0;
my $last_day_of_the_event = 0;
# If the ticket is not in the spanning tickets for today array, it means
# it's the first day of the event
if ( ( ! grep { $_ eq $TicketId } @$spanning_tickets_for_today ) ) {
    $first_day_of_the_event = 1;
}
if ( ( !grep { $_ eq $TicketId } @$spanning_tickets_for_tomorrow ) ) {
    $last_day_of_the_event = 1;
    # This frees up the position for the next ticket
    $WeekTicketPosition->{$CurrentPosition}->{id} = "";
}
</%perl>

<%perl>
# Determine appropriate class for ticket date type
my $ticket_type_class = '';
my $today_str = $Date->strftime("%Y-%m-%d");

# Check each date type to determine why this ticket appears on this date
if ( $DateTypes->{'Due'} && $Object->DueObj->IsSet && $Object->DueObj->Date(Format => 'ISO', Timezone => 'user') =~ /^$today_str/ ) {
    $ticket_type_class = 'due';
}
elsif ( $DateTypes->{'Starts'} && $Object->StartsObj->IsSet && $Object->StartsObj->Date(Format => 'ISO', Timezone => 'user') =~ /^$today_str/ ) {
    $ticket_type_class = 'starts';
}
elsif ( $DateTypes->{'Started'} && $Object->StartedObj->IsSet && $Object->StartedObj->Date(Format => 'ISO', Timezone => 'user') =~ /^$today_str/ ) {
    $ticket_type_class = 'started';
}
elsif ( $DateTypes->{'Created'} && $Object->CreatedObj->IsSet && $Object->CreatedObj->Date(Format => 'ISO', Timezone => 'user') =~ /^$today_str/ ) {
    $ticket_type_class = 'created';
}
elsif ( $DateTypes->{'Resolved'} && $Object->ResolvedObj->IsSet && $Object->ResolvedObj->Date(Format => 'ISO', Timezone => 'user') =~ /^$today_str/ ) {
    $ticket_type_class = 'resolved';
}
elsif ( $DateTypes->{'LastUpdated'} && $Object->LastUpdatedObj->IsSet && $Object->LastUpdatedObj->Date(Format => 'ISO', Timezone => 'user') =~ /^$today_str/ ) {
    $ticket_type_class = 'last-updated';
}
else {
    # Check for custom field dates - they appear in DateTypes as CF.{FieldName} after processing
    for my $date_type (keys %$DateTypes) {
        if ( $date_type =~ /^CF\.(.+)$/ ) {
            my $cf_name = $1;
            # Remove curly braces for method calls if present
            $cf_name =~ s/^\{(.*)\}$/$1/;

            my $cf_obj = $Object->LoadCustomFieldByIdentifier($cf_name);
            if ( $cf_obj && $cf_obj->id ) {
                my $cf_value = $Object->FirstCustomFieldValue($cf_name);
                if ( $cf_value ) {
                    my $cf_date = RT::Date->new($session{'CurrentUser'});
                    if ( $cf_obj->Type eq 'Date' ) {
                        $cf_date->Set(Format => 'unknown', Value => $cf_value);
                    } else {
                        $cf_date->Set(Format => 'ISO', Value => $cf_value);
                    }
                    if ( $cf_date->Date(Format => 'ISO', Timezone => 'user') =~ /^$today_str/ ) {
                        $ticket_type_class = 'custom-field';
                        last;
                    }
                }
            }
        }
    }
}
</%perl>

<div class="ticket-entry <% $ticket_type_class %>
% if ( $last_day_of_the_event ) {
    last-day
% }
% if ( $first_day_of_the_event || $DayOfWeek eq 1 ) {
    first-day
% }
"
% # Removed inline z-index style to allow CSS z-index control
data-object="<% $Object->Type %>-<% $Object->id %>"
   title="<% $subject %>"
   hx-get="<% RT->Config->Get("WebPath") %>/Helpers/CalendarEventInfo?event=<% $Object->Type %>-<% $Object->id %>"
   hx-trigger="mouseover once"
   hx-target="find .calendar-event-detail">

% if ( $first_day_of_the_event || $DayOfWeek eq 1 ) {
    <a href="<%$RT::WebPath%>/Ticket/Display.html?id=<%$TicketId%>">
       #<% $TicketId %>: <% $subject %>
    </a>
% }

% # Placeholder for the event details that will be loaded via AJAX on hover
<span class="calendar-event-detail rounded"></span>

</div>

<%init>

my $today = $Date->strftime("%F");
my $tomorrow = $Date->clone()->add(days => 1)->strftime("%F");

my $TicketId;

my $ticket;
my $subject;
my $IsReminder;
my $status;

if ($Object->Type eq 'reminder') {
    $IsReminder = 1;
    if ($Object->RefersTo->First) {
        $ticket   = $Object->RefersTo->First->TargetObj;
        $TicketId = $ticket->Id;
        $subject = $Object->Subject . " (" . $ticket->Subject . ")";
        $status = $Object->Status;
    }
} else {
    $TicketId = $Object->Id;
    $subject = $Object->Subject;
    $status = $Object->Status;
}

</%init>
<%args>
$Date => undef
$Object => undef
$DateTypes => undef
$DayOfWeek => undef
$TicketsSpanningDays => undef
$WeekTicketPosition => undef
$CurrentPosition => undef
</%args>
