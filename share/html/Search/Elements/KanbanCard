<div class="kanban-card card mb-2 shadow-sm"
     data-ticket-id="<% $Ticket->id %>"
     data-current-value="<% $current_value %>"
     draggable="true">
  <div class="card-body p-2">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <a href="<% RT->Config->Get('WebPath') %>/Ticket/Display.html?id=<% $Ticket->id %>" class="badge bg-primary-subtle text-primary text-decoration-none">
        #<% $Ticket->id %>
      </a>
    </div>

    <div class="mb-2 small">
      <a href="<% RT->Config->Get('WebPath') %>/Ticket/Display.html?id=<% $Ticket->id %>" class="text-decoration-none text-body">
        <% $Ticket->Subject || loc('(No subject)') %>
      </a>
    </div>

    <table class="kanban-card-fields inline-edit small">
      <tbody>
% for my $field (@$ParsedFormat) {
%   next if defined $field->{title} && $field->{title} eq 'NEWLINE';
%   my $attr = $field->{'attribute'} || $field->{'last_attribute'} || '';
%   next if $attr =~ /^(id|Subject)$/i;
        <& /Elements/CollectionAsTable/Row,
           Format     => [$field],
           record     => $Ticket,
           i          => 0,
           maxitems   => 1,
           Class      => 'RT__Ticket',
           InlineEdit => 1
        &>
% }
      </tbody>
    </table>
  </div>
</div>

<%INIT>
my $current_value = '';
if ( $KanbanField =~ /^CF\.\{(.+)\}$/ || $KanbanField =~ /^CustomField\.\{(.+)\}$/ ) {
    my $cf_name = $1;
    $current_value = $Ticket->FirstCustomFieldValue($cf_name) || '';
} elsif ( $KanbanField eq 'Priority' && RT->Config->Get('PriorityAsString') ) {
    $current_value = $Ticket->PriorityAsString || '';
} elsif ( $Ticket->can($KanbanField) ) {
    my $method = $KanbanField;
    $current_value = $Ticket->$method() || '';
    if ( ref($current_value) && $current_value->can('Name') ) {
        $current_value = $current_value->Name;
    } elsif ( ref($current_value) && $current_value->can('id') ) {
        $current_value = $current_value->id;
    }
} else {
    $current_value = '';
}
</%INIT>

<%ARGS>
$Ticket => undef
$KanbanField => 'Status'
$ParsedFormat => []
</%ARGS>
