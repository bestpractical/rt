<%init>
use RT::Search::Calendar;

# Bootstrap modal for date color legend will be added to template output

my $Month = $DECODED_ARGS->{SelectedMonth} // $DECODED_ARGS->{Month} // (localtime)[4];
my $Year = $DECODED_ARGS->{SelectedYear} // $DECODED_ARGS->{Year}  || (localtime)[5] + 1900;
my $Query = $DECODED_ARGS->{Query};
my $Format = $DECODED_ARGS->{Format};
my $Order = $DECODED_ARGS->{Order};
my $OrderBy = $DECODED_ARGS->{OrderBy};
my $RowsPerPage = $DECODED_ARGS->{RowsPerPage};
my $NewQuery = $DECODED_ARGS->{NewQuery};
my $BaseQuery = $DECODED_ARGS->{BaseQuery};

$BaseQuery ||= $Query;

my $rtdate = RT::Date->new($session{'CurrentUser'});

my $weekstart = 'Sunday'; #RT::SiteConfig?  user pref?
my %week = (
  'Saturday' => [6,0..5],
  'Sunday'   => [0..6],
  'Monday'   => [1..6,0],
);
my $startday_of_week = ${$week{$weekstart}}[0]  || 7;
my $endday_of_week   = ${$week{$weekstart}}[-1] || 7;

my $today = DateTime->today;
my $yesterday = $today->clone->subtract( days=>1 );
my $aweekago  = $today->clone->subtract( days=>7 );
my $date = RT::Search::Calendar::CalendarFirstDay($Year, $Month + 1, $startday_of_week );
my $end  = RT::Search::Calendar::CalendarLastDay ($Year, $Month + 1, $endday_of_week );

# use this to loop over days until $end
my $set = DateTime::Set->from_recurrence(
    next => sub { $_[0]->truncate( to => 'day' )->add( days => 1 ) }
);

# Default Query and Format
my $TempFormat = "__Starts__ __Due__";
my $TempQuery = "( Status = 'new' OR Status = 'open' OR Status = 'stalled')
 AND ( Owner = '" . $session{CurrentUser}->Id ."' OR Owner = 'Nobody'  )
 AND ( Type = 'reminder' OR 'Type' = 'ticket' )";

if ( $SavedSearchObj && $SavedSearchObj->Id ) {
    my $content = $SavedSearchObj->Content || {};
    $TempFormat = $content->{'Format'};
    $TempQuery = $content->{'Query'};
}

# Load saved search for reading options when not already provided
my $SavedSearchForOptions = $SavedSearchObj;
if ( !$SavedSearchForOptions && $ARGS{SavedSearchId} ) {
    $SavedSearchForOptions = RT::SavedSearch->new( $session{'CurrentUser'} );
    $SavedSearchForOptions->Load( $ARGS{SavedSearchId} );
    undef $SavedSearchForOptions unless $SavedSearchForOptions->Id;
}

my $CalendarColorMode = $DECODED_ARGS->{CalendarColorMode} || 'date';
if ( $CalendarColorMode eq 'date' && $SavedSearchForOptions && $SavedSearchForOptions->Id ) {
    $CalendarColorMode = $SavedSearchForOptions->GetOption('CalendarColorMode') || 'date';
}

# Collect status colors from ticket lifecycles during rendering.
# @SeenLifecycleOrder preserves the order lifecycles were first encountered.
# %SeenLifecycles maps lifecycle name => { status => color, ... }
my @SeenLifecycleOrder;
my %SeenLifecycles;
my $DefaultStatusColor = '#6c757d';

# we overide them if needed
$TempQuery  = $Query  if $Query;
$TempFormat = $Format if $Format;
$Format = $TempFormat unless $Format;

# Extract available statuses from queues referenced in the query for the filter dropdown
my @FilterLifecycleOrder;
my %FilterStatuses;

if ( $CalendarColorMode eq 'status' ) {
    my $query = $TempQuery || '';
    my $filter_data = ProcessQueryForFilters( Class => 'RT::Tickets', Query => $query, BaseQuery => $query );
    my @queues = @{ ( $filter_data || {} )->{queues} || [] };

    my %seen_lc;
    for my $queue (@queues) {
        my $lc_name = $queue->Lifecycle || 'default';
        next if $seen_lc{$lc_name}++;
        my $lc = $queue->LifecycleObj;
        next unless $lc;
        push @FilterLifecycleOrder, $lc_name;
        my %colors;
        for my $status ( $lc->Valid ) {
            next if $lc->IsInactive($status) && lc($status) eq 'deleted';
            $colors{ lc $status } = $lc->StatusColor($status) || $DefaultStatusColor;
        }
        $FilterStatuses{$lc_name} = \%colors;
    }
}

# Read CalendarStatusFilter and apply to query
my @CalendarStatusFilter;
if ( $CalendarColorMode eq 'status' && $DECODED_ARGS->{CalendarStatusFilter} ) {
    # Collect all valid statuses across lifecycles
    my %valid_statuses;
    for my $lc_name ( @FilterLifecycleOrder ) {
        $valid_statuses{$_} = 1 for keys %{ $FilterStatuses{$lc_name} || {} };
    }

    # Only keep statuses that exist in the known lifecycles
    @CalendarStatusFilter = grep { $valid_statuses{ lc $_ } } split /,/, $DECODED_ARGS->{CalendarStatusFilter};

    # Only apply filter if fewer statuses selected than available
    if ( @CalendarStatusFilter && @CalendarStatusFilter < scalar keys %valid_statuses ) {
        my $status_clause = join ' OR ', map { "Status = '$_'" } @CalendarStatusFilter;
        $TempQuery = "( $TempQuery ) AND ( $status_clause )";
    }
}

my $CalendarStatusFilterParam = join(',', @CalendarStatusFilter);
my $CalendarStatusFilterParamURI = $m->interp->apply_escapes($CalendarStatusFilterParam, 'u');

my $QueryString =
      $m->comp(
        '/Elements/QueryString',
        Query   => $BaseQuery,
        Format  => $Format,
        Order   => $Order,
        OrderBy => $OrderBy,
        Rows    => $RowsPerPage,
      );

# we search all date types in Format string
my @formats = $m->comp('/Elements/CollectionAsTable/ParseFormat', Format => $TempFormat);
my @Dates;
my ($explicit_starts, $explicit_ends);
for my $format (@formats) {
    if ( my $attr = $format->{attribute} ) {
        my $table_column = $m->comp(
            '/Elements/ColumnMap',
            Class => 'RT__Ticket',
            Name  => $attr,
            Attr  => 'attribute',
        );

        my $date_field;
        if ( $attr =~ /^(?:CF|CustomField(?:View)?)\./ ) {
            my $cf = RT::CustomField->new( RT->SystemUser );
            my $name = $table_column->();
            $cf->LoadByName( Name => $name, LookupType => 'RT::Queue-RT::Ticket' );
            if ( $cf->id && ( $cf->Type eq 'Date' || $cf->Type eq 'DateTime' ) ) {
                $date_field = "CF.{$name}";
                push @Dates, $date_field;
            }
        }
        elsif (RT::Ticket->_ClassAccessible->{$table_column}
            && RT::Ticket->_ClassAccessible->{$table_column}{type} eq 'datetime' )
        {
            $date_field = $table_column;
            push @Dates, $date_field;
        }

        # Check for /CALENDAR:start or /CALENDAR:end modifier
        if ( $date_field && $format->{calendar} ) {
            if ( lc $format->{calendar} eq 'start' ) {
                $explicit_starts //= $date_field;
            }
            elsif ( lc $format->{calendar} eq 'end' ) {
                $explicit_ends //= $date_field;
            }
        }
    }
}

@Dates = List::MoreUtils::uniq(@Dates);

# Use explicit /CALENDAR modifiers if both present, otherwise auto-detect
my ($starts_field, $ends_field);
if ( $explicit_starts && $explicit_ends ) {
    ($starts_field, $ends_field) = ($explicit_starts, $explicit_ends);
}
else {
    ($starts_field, $ends_field) = RT::Search::Calendar::GetMultipleDayFields(\@Dates);
}

$TempQuery .= RT::Search::Calendar::DatesClauses(\@Dates, $date->strftime("%F"), $end->strftime("%F"), $starts_field, $ends_field);

$m->callback( CallbackName => 'BeforeFindTickets', ARGSRef => \%ARGS, QueryRef => \$TempQuery, FormatRef => \$TempFormat );

my $DownloadQueryString =
      $m->comp(
        '/Elements/QueryString',
        Query   => $TempQuery,
        Format  => $Format,
        Order   => $Order,
        OrderBy => $OrderBy,
      );

my $Calendar;

# This is the expensive part of the processing, so only run this when
# htmx is rendering the main content.
if ( $m->request_path =~ /^(?:\/SelfService)?\/Views|Calendar.html/ ) {
    $Calendar = RT::Search::Calendar::GetCalendarTickets($session{'CurrentUser'}, $TempQuery, \@Dates, $date->strftime("%F"), $end->strftime("%F"), $starts_field, $ends_field);

    $m->callback(
        CallbackName   => 'ModifyCalendar',
        CalendarRef    => \$Calendar,
        BeginDate      => $date->strftime("%F"),
        EndDate        => $end->strftime("%F"),
        SavedSearchObj => $SavedSearchObj,
    );
}

my $BaseURL;
if ( $m->request_path =~ /Calendar\.html$/ ) {
    $BaseURL
        = RT->Config->Get('WebPath')
        . $m->request_path . '?'
        . QueryString( ShortenSearchQuery( map { $_ => $ARGS{$_} } grep { $_ !~ /^(?:Year|Month)$/ } keys %ARGS ) );
}

# Calendar uses unified event structure for improved performance and consistency

</%init>
<%args>
$Class => 'RT::Tickets'
$SavedSearchObj => undef
