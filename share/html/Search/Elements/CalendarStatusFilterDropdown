<ul class="dropdown-menu dropdown-menu-end calendar-status-filter-dropdown" data-bs-boundary="viewport">
  <li>
    <div class="dropdown-submenu">
      <div class="m-2 calendar-status-filter-header"><% loc('Show Statuses') %></div>
      <div class="d-flex justify-content-between align-items-center mb-2 px-2 filter-actions">
        <a href="#" onclick="return calendarStatusFilterSelectAll(this, event);" class="calendar-status-filter-select-link text-body-secondary text-decoration-none"><% loc('Select All') %></a>
        <a href="#" onclick="return calendarStatusFilterSelectNone(this, event);" class="calendar-status-filter-select-link text-body-secondary text-decoration-none"><% loc('Select None') %></a>
      </div>
<%perl>
my @merged = RT::Lifecycle->MergeLifecycleStatuses(@FilterLifecycleOrder);
my $group_by_lifecycle = @merged > 1;
my %active_filter = map { $_ => 1 } @CalendarStatusFilter;
my $all_selected = !@CalendarStatusFilter;

for my $entry ( @merged ) {
    my $lc_name = $entry->{lifecycle};
    my $lc = RT::Lifecycle->Load($lc_name);
</%perl>
% if ( $group_by_lifecycle ) {
      <div class="px-2 mt-2 mb-1 fw-semibold text-body-secondary small"><% $entry->{label} %></div>
% }
% for my $category (qw(initial active inactive)) {
%   for my $status ( sort $lc->Valid($category) ) {
%     next unless exists $FilterStatuses{$lc_name}{ lc $status };
%     my $color = $FilterStatuses{$lc_name}{ lc $status } || $DefaultStatusColor;
%     my $is_checked = $all_selected || $active_filter{ lc $status };
%     my $id = "cal-status-" . lc($status) . "-" . lc($lc_name);
%     $id =~ s/[^a-z0-9-]/-/g;
      <div class="form-check ms-3">
        <input class="form-check-input" type="checkbox" name="CalendarStatusFilter" value="<% lc $status %>" id="<% $id %>"<% $is_checked ? ' checked' : '' %> onchange="updateCalendarStatusFilterApply(jQuery(this).closest('.calendar-status-filter-dropdown'))">
        <label class="form-check-label" for="<% $id %>">
          <span class="d-inline-block rounded-circle me-1" style="width: 10px; height: 10px; background-color: <% $color %>; vertical-align: middle;"></span>
          <% $status %>
        </label>
      </div>
%   }
% }
% }
      <hr class="my-2 mx-3">
      <div class="px-3 d-flex justify-content-center mb-2">
        <button type="button" onclick="applyCalendarStatusFilter(this)" class="btn btn-primary calendar-status-filter-apply"><% loc('Apply') %></button>
      </div>
    </div>
  </li>
</ul>
<%args>
@FilterLifecycleOrder => ()
%FilterStatuses => ()
@CalendarStatusFilter => ()
$DefaultStatusColor => '#6c757d'
</%args>
