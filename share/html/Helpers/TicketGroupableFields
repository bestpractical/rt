<%ARGS>
$Query => ''
</%ARGS>
<%INIT>
# Returns a list of ticket fields suitable for grouping operations
# (Kanban boards, charts, reports, etc.)

my @fields;

# Standard ticket fields that make sense for grouping
my @standard_fields = qw(
    Status
    Queue
    Owner
    Creator
    LastUpdatedBy
    Priority
    Type
);

push @fields, @standard_fields;

# Extract queues from the query to get queue-specific custom fields
my @queue_ids;
if ( $Query ) {
    # Parse query for Queue restrictions
    while ( $Query =~ /Queue\s*=\s*(?:'([^']+)'|"([^"]+)"|(\d+)|(\S+))/gi ) {
        my $queue_identifier = $1 || $2 || $3 || $4;
        my $queue = RT::Queue->new( $session{'CurrentUser'} );

        if ( $queue_identifier =~ /^\d+$/ ) {
            $queue->Load( $queue_identifier );
        } else {
            $queue->Load( $queue_identifier );
        }

        push @queue_ids, $queue->Id if $queue->Id;
    }
}

# Get Custom Fields
my $CustomFields = RT::CustomFields->new( $session{'CurrentUser'} );
if ( @queue_ids ) {
    foreach my $id ( @queue_ids ) {
        my $queue = RT::Queue->new( $session{'CurrentUser'} );
        $queue->Load($id);
        next unless $queue->Id;
        $CustomFields->LimitToQueue( $queue->Id );
        $CustomFields->SetContextObject($queue) if @queue_ids == 1;
    }
}
$CustomFields->LimitToGlobal;

# Only include CF types that make sense for grouping
$CustomFields->Limit(
    FIELD => 'Type',
    OPERATOR => 'IN',
    VALUE => ['Select', 'Freeform', 'Text'],
    ENTRYAGGREGATOR => 'OR',
);

while ( my $CustomField = $CustomFields->Next ) {
    push @fields, "CustomField.{" . $CustomField->Name . "}";
}

# Get Custom Roles
my $CustomRoles = RT::CustomRoles->new( $session{'CurrentUser'} );
if ( @queue_ids ) {
    foreach my $id ( @queue_ids ) {
        my $queue = RT::Queue->new( $session{'CurrentUser'} );
        $queue->Load($id);
        next unless $queue->Id;
        $CustomRoles->LimitToObjectId( $queue->Id );
    }
}
$CustomRoles->LimitToLookupType(RT::Ticket->CustomFieldLookupType) if $CustomRoles->_isLimited;

while ( my $role = $CustomRoles->Next ) {
    push @fields, 'CustomRole.{' . $role->Name . '}';
}

# Return as JSON
$r->content_type('application/json; charset=utf-8');
$m->print( JSON( \@fields ) );
$m->abort;
</%INIT>
