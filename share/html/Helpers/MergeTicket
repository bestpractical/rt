<div class="modal-dialog modal-dialog-centered" role="document" aria-labelledby="merge-ticket-modal-title">
  <div class="modal-content">
    <div class="modal-header">
      <h5 class="modal-title" id="merge-ticket-modal-title"><% loc('Merge ticket #[_1]', $Ticket->id) %></h5>
      <a href="javascript:void(0)" class="close" data-bs-dismiss="modal" aria-label="<&|/l&>Close</&>"><span aria-hidden="true">&times;</span></a>
    </div>
    <form class="ticket-merge-form" hx-post="<% RT->Config->Get('WebPath') %>/Helpers/TicketUpdate" hx-swap="none">
      <input type="hidden" name="id" value="<% $Ticket->id %>" />
      <div class="modal-body">
        <& /Ticket/Elements/EditMerge, Ticket => $Ticket, MergeTextClass => 'text-warning' &>
      </div>
      <div class="modal-footer">
        <a href="javascript:void(0)" class="btn btn-secondary" data-bs-dismiss="modal"><&|/l&>Cancel</&></a>
        <button type="submit" class="btn btn-primary"><&|/l&>Merge</&></button>
      </div>
    </form>
  </div>
</div>
% $m->abort;
<%init>
my $Ticket = RT::Ticket->new( $session{'CurrentUser'} );
$Ticket->Load($id);

Abort('Permission Denied')
    unless $Ticket->id && $Ticket->CurrentUserHasRight('ModifyTicket');
</%init>
<%args>
$id
</%args>
