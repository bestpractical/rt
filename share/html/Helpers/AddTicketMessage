<div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable" role="document" aria-labelledby="inline-add-message-title">
  <div class="modal-content">
    <div class="modal-header">
      <h5 class="modal-title" id="inline-add-message-title"><% $title %></h5>
      <a href="javascript:void(0)" class="close" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </a>
    </div>
    <div class="modal-body inline-add-correspond">
      <form id="inline-add-message" name="TicketUpdate" hx-swap="none" hx-post="<% RT->Config->Get('WebPath') %>/Helpers/TicketUpdate" enctype="multipart/form-data">
        <input type="hidden" class="hidden" name="id" value="<% $Ticket->id %>" />
        <input type="hidden" class="hidden" name="UpdateType" value="<% $UpdateType %>" />
        <input type="hidden" class="hidden" name="InlineAddMessage" value="1" />
        <input type="hidden" class="hidden" name="RenderTxnRecipientsInput" value="1" />
        <&|/Widgets/TitleBox, title => loc('Recipients'), class => 'ticket-info-recipients' &>
% for my $address ( grep { defined } ref $ARGS{TxnSendMailTo} ? @{$ARGS{TxnSendMailTo}} : $ARGS{TxnSendMailTo} ) {
          <input type="hidden" name="TxnSendMailTo" value="<% $address %>" />
% }
          <input type="hidden" name="TxnRecipients" value="<% $ARGS{TxnRecipients} || '' %>" />
          <script type="text/javascript">
            registerLoadListener(ticketUpdateRecipients);
          </script>
        </&>
        <&|/Widgets/TitleBox, title => loc('Message') &>
          <& /Ticket/Elements/MessageDetails,
            %ARGS,
            TicketObj               => $Ticket,
            HideCc                  => 1,
            HideBcc                 => 1,
            HideAttachments         => 1,
            ArticleAutoSubmitAction => 'inlineAddMessageIncludeArticle()'
          &>
          <div class="row mt-2">
            <div class="col-12 text-end">
              <input type="button" class="btn btn-primary submit" value="<&|/l&>Send</&>" />
            </div>
          </div>
        </&>
      </form>
    </div>
  </div>
</div>
% $m->abort;

<%INIT>
my $Ticket = RT::Ticket->new($session{'CurrentUser'});
$Ticket->Load( $id );

Abort('Permission Denied')
    unless $Ticket->CurrentUserHasRight('ModifyTicket')
    || ( $UpdateType eq 'private' ? $Ticket->CurrentUserHasRight('CommentOnTicket')
                                  : $Ticket->CurrentUserHasRight('ReplyToTicket') );

my $title
    = $UpdateType eq 'private' ? loc( 'Comment to Ticket #[_1]', $id ) : loc( 'Reply to Ticket #[_1]', $id );
</%INIT>

<%ARGS>
$id
$UpdateType => 'private'
</%ARGS>
