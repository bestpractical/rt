<%init>
my $error_response = sub {
    my $code = shift;
    my $msg  = shift;
    $r->status($code);
    $r->content_type('application/json; charset=utf-8');
    $m->out( JSON({ error => $msg }) );
    $m->abort;
};

unless ( $r->method eq 'POST' ) {
    $error_response->( 405, loc('Method not allowed') );
}

my $current = $session{CurrentUser};
unless ( $current && $current->id ) {
    $error_response->( 403, loc('Authentication required') );
}

require RT::Passkey;
require RT::Passkeys;

my $target_id = $user_id // $current->id;
$error_response->( 400, loc('Invalid user id') ) unless $target_id =~ /\A\d+\z/;
my $is_self = ( $target_id == $current->id );
unless ( $is_self || $current->HasRight( Object => RT->System, Right => 'AdminUsers' ) ) {
    $error_response->( 403, loc('Permission denied') );
}

# Externally-authed sessions can't self-manage passkeys (matches the
# Prefs UI gate). Cross-user admin actions are still allowed so an
# externally-authed admin can clear a user's credentials.
if ( $is_self && $session{WebExternallyAuthed} ) {
    $error_response->( 403, loc('Passkey management is not available for externally authenticated sessions') );
}

my $target = RT::User->new( $session{CurrentUser} );
$target->Load($target_id);
$error_response->( 404, loc('User not found') ) unless $target->id;

if ( ($action // '') eq 'list' ) {
    my $passkeys = RT::Passkeys->new( $session{CurrentUser} );
    $passkeys->LimitToUser( $target->id );
    $passkeys->OrderBy( FIELD => 'Created', ORDER => 'DESC' );

    my @rows;
    while ( my $passkey = $passkeys->Next ) {
        push @rows, {
            id        => $passkey->id,
            name      => $passkey->Name,
            created   => $passkey->Created,
            last_used => $passkey->LastUsed,
        };
    }
    $r->content_type('application/json; charset=utf-8');
    $m->out( JSON( \@rows ) );
    $m->abort;
}
elsif ( ($action // '') eq 'rename' ) {
    $error_response->( 400, loc('Missing id') ) unless $id;

    my $new_name = RT::Passkey->CanonicalizeName( $name // '' );
    $error_response->( 400, loc('Name is required') ) unless length $new_name;
    $error_response->( 400, loc('Name too long') ) if length $new_name > 255;

    my $passkey = RT::Passkey->new( $session{CurrentUser} );
    $passkey->Load($id);
    $error_response->( 404, loc('Credential not found') ) unless $passkey->id;
    $error_response->( 404, loc('Credential not found') ) unless $passkey->UserId == $target->id;

    my $old = $passkey->Name // '';
    if ( $old ne $new_name ) {
        my $name_lc  = lc $new_name;
        my $siblings = RT::Passkeys->new( $session{CurrentUser} );
        $siblings->LimitToUser( $target->id );
        while ( my $p = $siblings->Next ) {
            next if $p->id == $passkey->id;
            $error_response->( 400, loc('You already have a passkey with this name') )
                if lc( $p->__Value('Name') // '' ) eq $name_lc;
        }

        my ( $ret, $msg ) = $passkey->SetName($new_name);
        $error_response->( 500, loc('Could not rename: [_1]', $msg) ) unless $ret;
    }

    $r->content_type('application/json; charset=utf-8');
    $m->out( JSON({ ok => 1 }) );
    $m->abort;
}
elsif ( ($action // '') eq 'delete' ) {
    $error_response->( 400, loc('Missing id') ) unless $id;

    my $passkey = RT::Passkey->new( $session{CurrentUser} );
    $passkey->Load($id);
    $error_response->( 404, loc('Credential not found') ) unless $passkey->id;
    $error_response->( 404, loc('Credential not found') ) unless $passkey->UserId == $target->id;

    my ( $ret, $msg ) = $passkey->Delete;
    $error_response->( 500, loc('Could not delete: [_1]', $msg) ) unless $ret;

    $r->content_type('application/json; charset=utf-8');
    $m->out( JSON({ ok => 1 }) );
    $m->abort;
}
elsif ( ($action // '') eq 'delete_all' ) {
    my ( $ret, $msg ) = $target->ClearPasskeys;
    $error_response->( 500, loc('Could not delete: [_1]', $msg) ) unless $ret;

    $r->content_type('application/json; charset=utf-8');
    $m->out( JSON({ ok => 1 }) );
    $m->abort;
}
else {
    $error_response->( 400, loc('Unknown action') );
}
</%init>
<%args>
$action  => undef
$user_id => undef
$id      => undef
$name    => undef
</%args>
