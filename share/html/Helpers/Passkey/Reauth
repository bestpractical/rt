<%init>
my $error_response = sub {
    my ( $code, $msg ) = @_;
    $r->status($code);
    $r->content_type('application/json; charset=utf-8');
    $m->out( JSON({ error => $msg }) );
    $m->abort;
};

unless ( $r->method eq 'POST' ) {
    $error_response->( 405, loc('Method not allowed') );
}

my $current = $session{CurrentUser};
unless ( $current && $current->id ) {
    $error_response->( 403, loc('Authentication required') );
}

# Externally-authed sessions delegate authentication upstream; an RT
# password (if one happens to be set) is not the right step-up factor.
if ( $session{WebExternallyAuthed} ) {
    $error_response->( 403, loc('Re-authentication is not available for externally authenticated sessions') );
}

my $user = $current->UserObj;
unless ( $user->HasPassword ) {
    # No password to verify against. Without a second factor (e.g., a
    # current passkey assertion) there is nothing to step up with.
    $error_response->( 400, loc('Account has no password set; cannot re-authenticate') );
}

# Refuse further attempts once this session has burned through its
# budget. Lockout is session-scoped so a parallel legitimate session
# isn't punished for the attacker's grinding.
if ( ( $session{PasskeyReauthFailures} // 0 ) >= $RT::Interface::Web::REAUTH_MAX_FAILURES ) {
    RT->Logger->warning(
        "Passkey re-auth lockout for user " . $user->Name
        . " from " . RT::Interface::Web::RequestENV('REMOTE_ADDR')
    );
    $error_response->( 429, loc('Too many re-authentication attempts. Log in again to continue.') );
}

unless ( defined $password && length $password && $user->IsPassword($password) ) {
    $session{PasskeyReauthFailures} = ( $session{PasskeyReauthFailures} // 0 ) + 1;
    RT->Logger->info(
        "Passkey re-auth failed for user " . $user->Name
        . " from " . RT::Interface::Web::RequestENV('REMOTE_ADDR')
        . " (attempt $session{PasskeyReauthFailures}/$RT::Interface::Web::REAUTH_MAX_FAILURES)"
    );
    $error_response->( 403, loc('Incorrect password') );
}

delete $session{PasskeyReauthFailures};
RT::Interface::Web::MarkInteractiveAuth(\%session);

$r->content_type('application/json; charset=utf-8');
$m->out( JSON({ ok => 1 }) );
$m->abort;
</%init>
<%args>
$password => undef
</%args>
